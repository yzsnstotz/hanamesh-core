{
  "name": "@hanamesh/market",
  "version": "0.1.0",
  "description": "HanaMesh market tab for the native DSH Plugins page.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yzsnstotz/hanamesh-core.git",
    "directory": "packages/hanamesh-market"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./installation-status": {
      "types": "./lib/installation-status.d.ts",
      "default": "./lib/installation-status.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CONTRACT.md",
    "LICENSE",
    "INSTALL_TARGET.md",
    "INSTALLATION_STATUS.md"
  ],
  "engines": {
    "node": ">=24.13.1 <25",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test --test-reporter=tap --test-concurrency=1 test/*.test.mjs tests/*.test.mjs",
    "test:contract": "node --test --test-reporter=tap test/host.test.mjs",
    "test:mutations": "node scripts/mutations.mjs",
    "verify:pack": "node scripts/verify-pack.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "semver": "7.8.5",
    "zod": "4.4.3",
    "@hanamesh/api-contracts": "git+https://github.com/yzsnstotz/hanamesh-api-contracts.git#967988fdda4ea7ebf414e16b55d8d4c4dad0736f",
    "ajv": "8.20.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.1.0 <4.2.0-0",
    "@deepseek-ai/schemastery": ">=3.19.0 <3.20.0-0",
    "react": "^18.3.1",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-connection": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-app-boot": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-plugin-manager": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-plugin-detail": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-locale": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/schemastery": "3.19.0",
    "react": "18.3.1",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.1",
    "@deepseek-ai/dsh-app-boot": "0.2.2-rc.1",
    "@deepseek-ai/dsh-plugin-manager": "0.2.2-rc.1",
    "@deepseek-ai/dsh-plugin-detail": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.1",
    "typescript": "5.9.3",
    "js-yaml": "4.1.1",
    "@types/node": "24.13.4",
    "@hanamesh/devkit": "^0.2.6"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "external": [
        "react"
      ],
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "types": "./lib/index.d.ts"
}
