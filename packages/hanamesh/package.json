{
  "name": "@hanamesh/hanamesh",
  "version": "0.1.5",
  "hanameshSuiteInstall": {
    "name": "@hanamesh/hanamesh",
    "version": "0.1.5",
    "command": "dsh plugin --profile desktop add --save-exact @hanamesh/hanamesh@0.1.5",
    "args": [
      "plugin",
      "--profile",
      "desktop",
      "add",
      "--save-exact",
      "@hanamesh/hanamesh@0.1.5"
    ]
  },
  "description": "HanaMesh Core, Usage, AppHost and Theme for DSH in one installation.",
