{
  "name": "@hanamesh/theme",
  "version": "0.1.0",
  "description": "HanaMesh A light and dark theme for DSH; reversible token overrides.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yzsnstotz/hanamesh-core.git",
    "directory": "packages/hanamesh-theme"
  },
  "engines": {
    "node": ">=24.13.1 <25"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test --test-reporter=tap test/*.test.mjs",
    "prepack": "npm run build",
    "verify:pack": "npm run build && node scripts/verify-pack.mjs",
    "test:mutations": "npm run build && node scripts/mutations.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.1.0 <4.2.0-0",
    "@deepseek-ai/dsh-client-ui-theme": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
