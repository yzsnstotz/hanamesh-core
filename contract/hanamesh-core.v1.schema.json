{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hanamesh-core/contract/hanamesh-core.v1.schema.json",
  "title": "hanameshCore service contract, protocol v1",
  "description": "Data shapes returned by the Cordis service `hanameshCore`. Methods are listed under x-hanamesh; they are functions and cannot be expressed in JSON Schema. Source of truth: hanamesh-core src/contract.ts and docs/CORE_CONTRACT.md.",
  "x-hanamesh": {
    "service": "hanameshCore",
    "protocolVersion": "1",
    "requiredMethods": [
      "getDeviceId",
      "sign",
      "signRequest",
      "getConsent",
      "onConsentChange",
      "getSession",
      "getServerOrigin"
    ],
    "optionalMethods": [
      "getPublicKey",
      "getHealth",
      "getSuiteDeclaration"
    ],
    "handshake": {
      "order": [
        "CORE_ABSENT",
        "CORE_NOT_OBJECT",
        "CORE_PROTOCOL_UNSUPPORTED",
        "CORE_METHOD_MISSING"
      ],
      "statuses": [
        "present",
        "absent",
        "incompatible"
      ]
    },
    "methods": {
      "getDeviceId": {
        "returns": "#/$defs/DeviceId",
        "note": "available right after apply; does not depend on registration"
      },
      "getPublicKey": {
        "returns": "#/$defs/PublicKey",
        "note": "raw 32-byte Ed25519 key, base64url"
      },
      "sign": {
        "input": "Uint8Array",
        "returns": "Uint8Array(64)",
        "note": "Ed25519 over the given bytes; synchronous; the private key never leaves the process"
      },
      "signRequest": {
        "input": "#/$defs/RequestSignatureInput",
        "returns": "Promise<#/$defs/DeviceAuthHeaders>",
        "canonical": "METHOD|pathname|unixMilliseconds|nonce|hex(sha256(body || ''))",
        "note": "METHOD upper-cased; pathname is path without ?query or #fragment; invalid input rejects"
      },
      "getConsent": {
        "returns": "#/$defs/ConsentState"
      },
      "onConsentChange": {
        "input": "(state: ConsentState, changedAt: ISO-8601 string) => void",
        "returns": "() => void",
        "note": "does not replay the current value on subscribe; the returned function unsubscribes"
      },
      "getSession": {
        "returns": "#/$defs/SessionSnapshot",
        "note": "observation, may be stale; not proof of authorization"
      },
      "getServerOrigin": {
        "returns": "#/$defs/ServerOrigin",
        "note": "null = offline"
      },
      "getHealth": {
        "returns": "#/$defs/HealthSnapshot"
      },
      "getSuiteDeclaration": {
        "input": "#/$defs/SuiteDeclarationRequest | undefined",
        "returns": "Promise<#/$defs/SuiteDeclaration>",
        "note": "Optional protocol1 read-only declaration; no args means current facts and candidate source missing. No install authorization."
      }
    },
    "notExposed": [
      "private key",
      "PKCS8",
      "token",
      "cookie",
      "transport instance",
      "storage-domain write interface"
    ],
    "localHttp": {
      "state": {
        "method": "GET",
        "path": "/api/hanamesh/core/state",
        "consentPrompt": "#/$defs/ConsentPrompt"
      },
      "consentPromptShown": {
        "method": "POST",
        "path": "/api/hanamesh/core/consent/prompt-shown",
        "body": null,
        "returns": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shownAt"
          ],
          "properties": {
            "shownAt": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "DeviceId": {
      "type": "string",
      "minLength": 1
    },
    "PublicKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "ConsentState": {
      "enum": [
        "granted",
        "withheld"
      ]
    },
    "ServerOrigin": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "RequestSignatureInput": {
      "type": "object",
      "required": [
        "method",
        "path",
        "body"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "body": {
          "description": "Uint8Array or null; binary, not representable in JSON"
        }
      }
    },
    "DeviceAuthHeaders": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x-hm-device-id",
        "x-hm-timestamp",
        "x-hm-nonce",
        "x-hm-signature"
      ],
      "properties": {
        "x-hm-device-id": {
          "type": "string",
          "minLength": 1
        },
        "x-hm-timestamp": {
          "type": "string",
          "pattern": "^[0-9]{13,}$"
        },
        "x-hm-nonce": {
          "type": "string",
          "minLength": 1
        },
        "x-hm-signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      }
    },
    "SessionSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "deviceId",
        "registration",
        "principalId",
        "bound",
        "serverReachable",
        "checkedAt",
        "reason"
      ],
      "properties": {
        "protocolVersion": {
          "const": "1"
        },
        "deviceId": {
          "$ref": "#/$defs/DeviceId"
        },
        "registration": {
          "enum": [
            "unregistered",
            "registered",
            "failed"
          ]
        },
        "principalId": {
          "type": [
            "string",
            "null"
          ]
        },
        "bound": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "serverReachable": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "checkedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "HealthSnapshot": {
      "type": "object",
      "required": [
        "revision",
        "mode",
        "components"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "mode": {
          "enum": [
            "normal",
            "restricted",
            "blocked",
            "repair"
          ]
        },
        "components": {
          "type": "array"
        },
        "fault": {
          "type": "string"
        }
      }
    },
    "SuiteDeclarationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry"
      ],
      "properties": {
        "registry": {
          "type": "string",
          "minLength": 1
        },
        "coreVersion": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "SuiteDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "checkedAt",
        "declarationId",
        "manifest",
        "nodeVersion",
        "registry",
        "completeness",
        "installed",
        "upgrades",
        "blocked",
        "peerFacts",
        "metadataDigests"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "checkedAt": {
          "type": "string",
          "minLength": 1
        },
        "declarationId": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "manifest": {
          "$ref": "#/$defs/SuiteManifest"
        },
        "nodeVersion": {
          "type": "string"
        },
        "registry": {
          "type": [
            "string",
            "null"
          ]
        },
        "completeness": {
          "enum": [
            "complete",
            "incomplete",
            "unknown"
          ]
        },
        "installed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SuiteInstalled"
          }
        },
        "upgrades": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SuiteUpgrade"
          }
        },
        "blocked": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SuiteBlocked"
          }
        },
        "peerFacts": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "metadataDigests": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "SuiteManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "core",
        "components"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "core": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version",
            "repository"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "repository": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "moduleName",
              "versionRange",
              "repository"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "moduleName": {
                "type": "string",
                "minLength": 1
              },
              "versionRange": {
                "type": "string",
                "minLength": 1
              },
              "repository": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "SuiteInstalled": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "moduleName",
        "requiredRange",
        "repository",
        "actualVersion",
        "actualRepository",
        "status"
      ],
      "properties": {
        "moduleName": {
          "type": "string",
          "minLength": 1
        },
        "requiredRange": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "actualVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "actualRepository": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "runningVersion": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "SuiteTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "moduleName",
        "version",
        "repository",
        "metadataDigest"
      ],
      "properties": {
        "moduleName": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "metadataDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "SuiteUpgrade": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coreVersion",
        "registry",
        "manifestDigest",
        "targets"
      ],
      "properties": {
        "coreVersion": {
          "type": "string",
          "minLength": 1
        },
        "registry": {
          "type": "string",
          "minLength": 1
        },
        "manifestDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SuiteTarget"
          }
        }
      }
    },
    "SuiteBlocked": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "CORE_SUITE_SOURCE_MISSING",
            "CORE_SUITE_BUNDLE_MISSING",
            "CORE_SUITE_BUNDLE_INVALID"
          ]
        },
        "coreVersion": {
          "type": "string",
          "minLength": 1
        },
        "moduleName": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ConsentPrompt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "show",
        "shownAt"
      ],
      "properties": {
        "show": {
          "type": "boolean"
        },
        "shownAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    }
  }
}
