{
  "schemaVersion": 1,
  "id": "hanamesh-suite",
  "version": "0.3.41",
  "label": "HanaMesh 套件",
  "runningTaskPolicy": "preserve-and-pause",
  "components": [
    {
      "id": "usage",
      "moduleName": "@hanamesh/usage",
      "loaderEntryId": "hanamesh-usage",
      "label": "使用记录",
      "versionRange": ">=0.2.0-rc.26 <0.3.0 || >=0.3.0-rc.1 <0.4.0",
      "onFailure": "notice",
      "impact": "不采集、不上报使用记录；设备身份与同意开关不受影响",
      "repository": "https://github.com/yzsnstotz/hanamesh-usage"
    },
    {
      "id": "market",
      "moduleName": "@hanamesh/market",
      "loaderEntryId": "hanamesh-market",
      "label": "市场（Market）",
      "versionRange": ">=0.1.2 <0.2.0",
      "onFailure": "notice",
      "impact": "无法浏览或安装市场插件；设备身份与同意开关不受影响",
      "repository": "https://github.com/yzsnstotz/hanamesh-core"
    },
    {
      "id": "theme",
      "moduleName": "@hanamesh/theme",
      "loaderEntryId": "hanamesh-theme",
      "label": "主题（Theme）",
      "versionRange": ">=0.1.0 <0.2.0",
      "onFailure": "notice",
      "impact": "HanaMesh 主题不可用；设备身份与同意开关不受影响",
      "repository": "https://github.com/yzsnstotz/hanamesh-core"
    }
  ]
}
