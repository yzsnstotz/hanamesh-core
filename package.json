{
  "name": "hanamesh-core",
  "version": "0.2.0-rc.54",
  "description": "HanaMesh Core: device identity, consent, component health, and suite entrypoint.",
  "type": "module",
  "main": "./lib/dsh.mjs",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./lib/dsh.mjs"
    },
    "./contract": {
      "types": "./lib/contract.d.ts",
      "default": "./lib/contract.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "types",
    "profile",
    "profile.schema.json",
    "consistency.json",
    "docs/CORE_CONTRACT.md",
    "docs/API.md",
    "docs/SECURITY.md",
    "vendor/semver",
    "vendor/SHA256SUMS",
    "vendor/srv-identity"
  ],
  "engines": {
    "node": "24.13.1"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "node scripts/build.mjs --target",
    "build:offline": "node scripts/build.mjs --offline",
    "test": "node --test --test-reporter=tap test/*.test.mjs",
    "test:mutations": "node scripts/mutation.mjs",
    "test:crash": "node --test --test-reporter=tap test/crash.test.mjs",
    "verify:inputs": "node scripts/verify-inputs.mjs",
    "preflight": "node scripts/preflight.mjs",
    "check:contracts": "tsc --noEmit --strict --skipLibCheck false --target ES2022 --module NodeNext --moduleResolution NodeNext test/public-contracts.ts",
    "check:toolchain": "hanamesh-devkit check-toolchain",
    "verify:pack": "node scripts/check-package.mjs",
    "pack": "npm pack --pack-destination artifacts",
    "check": "pnpm check:toolchain && pnpm verify:inputs && pnpm check:contracts && pnpm preflight"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.0-rc.2",
    "react": "18.3.1",
    "zod": "4.5.4",
    "@hanamesh/devkit": "0.1.0-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.0-rc.2",
    "@types/node": "24.13.4",
    "@types/react": "18.3.12",
    "react": "18.3.1",
    "typescript": "5.9.3",
    "zod": "4.5.4",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.0-rc.2",
    "@hanamesh/devkit": "file:vendor/hanamesh-devkit-0.1.0-rc.1.tgz"
  },
  "pnpm": {
    "overrides": {
      "@deepseek-ai/cordis": "4.0.4",
      "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2",
      "@deepseek-ai/dsh-storage-domain": "0.2.0-rc.2",
      "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2",
      "@deepseek-ai/dsh-client-ui-sidebar": "0.2.0-rc.2",
      "@deepseek-ai/dsh-storage": "0.2.0-rc.2",
      "@deepseek-ai/dsh-invariants": "0.2.0-rc.2",
      "@deepseek-ai/dsh-credentials": "0.2.0-rc.2"
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./profile/cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web",
      "external": [
        "react"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yzsnstotz/hanamesh-core.git"
  },
  "license": "MIT",
  "peerDependenciesMeta": {
    "@hanamesh/devkit": {
      "optional": true
    }
  }
}
