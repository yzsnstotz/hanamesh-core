{
  "name": "@hanamesh/core",
  "version": "0.3.25",
  "description": "HanaMesh Core: device identity, consent, component health, and suite entrypoint.",
  "type": "module",
  "main": "./lib/dsh.mjs",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./lib/dsh.mjs"
    },
    "./contract": {
      "types": "./lib/contract.d.ts",
      "default": "./lib/contract.js"
    },
    "./contract/fixtures": {
      "types": "./lib/contract-fixtures.d.ts",
      "default": "./lib/contract-fixtures.js"
    },
    "./contract/suite": {
      "types": "./lib/contract-suite.d.ts",
      "default": "./lib/contract-suite.js"
    },
    "./contract/schema.json": "./contract/hanamesh-core.v1.schema.json",
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./suite": {
      "types": "./lib/suite/index.d.ts",
      "default": "./lib/suite/index.js"
    },
    "./suite/source": {
      "types": "./lib/suite/source.d.ts",
      "default": "./lib/suite/source.js"
    }
  },
  "bin": {
    "hanamesh-core-contract-suite": "./lib/contract-cli.js",
    "hanamesh-core-agent": "./lib/agent-cli.js"
  },
  "files": [
    "lib",
    "contract",
    "types",
    "profile",
    "profile.schema.json",
    "consistency.json",
    "docs/CORE_CONTRACT.md",
    "docs/API.md",
    "docs/SECURITY.md",
    "docs/AGENT.md",
    "docs/SUITE_DECLARATION.md"
  ],
  "engines": {
    "node": ">=24.13.1 <25"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "node scripts/build.mjs --target",
    "build:offline": "node scripts/build.mjs --offline",
    "test": "node --test --test-reporter=tap test/*.test.mjs",
    "test:mutations": "node scripts/mutation.mjs",
    "test:contract": "pnpm run build && node lib/contract-cli.js",
    "test:crash": "node --test --test-reporter=tap test/crash.test.mjs",
    "verify:inputs": "node scripts/verify-inputs.mjs",
    "preflight": "node scripts/preflight.mjs",
    "check:contracts": "tsc --noEmit --strict --skipLibCheck false --target ES2022 --module NodeNext --moduleResolution NodeNext test/public-contracts.ts",
    "check:toolchain": "hanamesh-devkit check-toolchain",
    "verify:pack": "node scripts/check-package.mjs",
    "pack": "npm pack --pack-destination \"${HM_CORE_RUN:?set external Core run directory}\"",
    "check": "pnpm check:toolchain && pnpm verify:inputs && pnpm check:contracts && pnpm preflight",
    "prepack": "node scripts/build.mjs --target"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4 <4.1.0-0 || >=4.0.5-alpha.1 <4.1.0-0",
    "@deepseek-ai/dsh-client-connection": ">=0.2.0-rc.2 <0.3.0-0 || >=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.0-rc.2 <0.3.0-0 || >=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.0-rc.2 <0.3.0-0 || >=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.2.0-rc.2 <0.3.0-0 || >=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/dsh-scope": ">=0.2.0-rc.2 <0.3.0-0 || >=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/dsh-storage": ">=0.2.0-rc.2 <0.3.0-0 || >=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.0-rc.2 <0.3.0-0 || >=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.0-rc.2 <0.3.0-0 || >=0.2.1-0 <0.3.0-0",
    "react": "^18.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-client-connection": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-store": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-scope": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-storage": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-util-code-language": "0.2.1-alpha.2",
    "@hanamesh/devkit": "git+https://github.com/yzsnstotz/hanamesh-server-shared.git#semver:^0.2.0&path:/packages/devkit",
    "@types/mdast": "4.0.4",
    "@types/node": "24.13.4",
    "@types/react": "18.3.12",
    "@types/semver": "7.7.1",
    "js-yaml": "4.1.1",
    "react": "18.3.1",
    "typescript": "5.9.3",
    "zod": "4.5.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./profile/cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web",
      "external": [
        "react"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yzsnstotz/hanamesh-core.git"
  },
  "license": "MIT",
  "dependencies": {
    "semver": "7.7.2",
    "tar": "7.5.22"
  },
  "hanameshSuite": {
    "schemaVersion": 1,
    "id": "hanamesh-suite",
    "core": {
      "name": "@hanamesh/core",
      "version": "0.3.25",
      "repository": "https://github.com/yzsnstotz/hanamesh-core"
    },
    "components": [
      {
        "id": "usage",
        "moduleName": "@hanamesh/usage",
        "versionRange": ">=0.2.0-rc.26 <0.3.0 || >=0.3.0-rc.1 <0.4.0",
        "repository": "https://github.com/yzsnstotz/hanamesh-usage"
      },
      {
        "id": "app-host",
        "moduleName": "@hanamesh/dsh-app-host",
        "versionRange": ">=0.5.9 <0.7.0",
        "repository": "https://github.com/yzsnstotz/hanamesh-plugin-app-host"
      }
    ]
  }
}
