{
  "name": "hanamesh-plugin-identity",
  "version": "0.1.0-rc.1",
  "description": "HanaMesh MOD-02: pinned DSH identity UI and credential-isolated client SDK",
  "private": true,
  "type": "module",
  "main": "./lib/dsh.mjs",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./lib/dsh.mjs"
    },
    "./contracts": {
      "types": "./lib/contracts.d.ts",
      "default": "./lib/contracts.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "types",
    "vendor/srv-identity/contracts.d.ts",
    "vendor/srv-identity/API.md",
    "AGENTS.md",
    "consistency.json",
    "docs/API.md",
    "docs/SECURITY.md",
    "profile"
  ],
  "engines": {
    "node": "24.13.1"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "node scripts/build.mjs --target",
    "build:offline": "node scripts/build.mjs --offline",
    "test": "node --test --test-reporter=tap test/*.test.mjs",
    "test:mutation": "node scripts/mutation.mjs",
    "test:crash": "node --test --test-reporter=tap test/crash.test.mjs",
    "verify:inputs": "node scripts/verify-inputs.mjs",
    "preflight": "node scripts/preflight.mjs",
    "check:contracts": "tsc --noEmit --strict --skipLibCheck false --target ES2022 --module NodeNext --moduleResolution NodeNext test/public-contracts.ts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-client-connection": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-storage-domain": "0.1.5-alpha.1",
    "hanamesh-ui-kit": "0.1.0-rc.3",
    "zod": "4.4.3"
  },
  "overrides": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-client-connection": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-storage-domain": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-storage": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-invariants": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-credentials": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-llm": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-attachment": "0.1.5-alpha.1"
  },
  "license": "UNLICENSED"
}
